* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: linear-gradient(180deg, #ffd6e0, #88bef1);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.container {
    background: #ffffff;
    padding: 30px;
    width: 350px;
    border-radius: 25px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.profile-img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
    border: 4px solid #ffc1cc;
}

h1 {
    color: #ff6f91;
    margin-bottom: 5px;
}

.subtitle {
    color: #888;
    margin-bottom: 20px;
    font-size: 14px;
}

.links a {
    display: block;
    text-decoration: none;
    color: #ff6f91;
    background: #ffe4ec;
    padding: 12px;
    margin: 10px 0;
    border-radius: 15px;
    transition: 0.3s;
    font-weight: bold;
}

.links a:hover {
    background: #ffb3c6;
    color: white;
}

.section {
    color: #ff6f91;
    margin-top: 20px;
    margin-bottom: 10px;
    text-align: left;
}

.video iframe {
    width: 100%;
    height: 200px;
    border-radius: 15px;
}
